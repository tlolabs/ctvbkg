<Window
    x:Class="ChabotBackgrounder.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Backgrounder Progress">
    <StackPanel Padding="16" Spacing="6">
        <TextBlock x:Name="OverlayStatus" Text="Footage remaining" FontWeight="SemiBold" />
        <TextBlock x:Name="OverlayTime" Text="141:10" FontSize="30" FontWeight="SemiBold" />
        <ProgressBar x:Name="OverlayProgress" Minimum="0" Maximum="8470000" />
    </StackPanel>
</Window>
